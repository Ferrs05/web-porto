---
import { Github, Instagram, Mail, MessageCircle, Send } from 'lucide-react';
---

<section id="contact" class="section contact">
  <div class="container contact-panel card">
    <div class="contact-copy">
      <p class="eyebrow">Contact</p>
      <h2 class="section-title">Drop Me <span class="accent-serif">a Line</span></h2>
      <p class="section-lead">
        Have a project, opportunity, collaboration idea, or just want to connect? Send a message and I will get back to
        you through email.
      </p>
      <div class="contact-links" aria-label="Social contact links">
        <a href="mailto:muhferry.saputra@gmail.com"><Mail size={18} /> Email</a>
        <a href="https://github.com/Ferrs05" target="_blank" rel="noreferrer"><Github size={18} /> GitHub</a>
        <a href="https://wa.me/628979153142" target="_blank" rel="noreferrer"><MessageCircle size={18} /> WhatsApp</a>
        <a href="https://instagram.com/ferr.spt" target="_blank" rel="noreferrer"><Instagram size={18} /> Instagram</a>
      </div>
    </div>

    <form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="REPLACE_WITH_WEB3FORMS_ACCESS_KEY" />
      <input type="hidden" name="subject" value="New portfolio message for Muhammad Ferry Saputra" />
      <label>
        Name
        <input required type="text" name="name" placeholder="Your name" />
      </label>
      <label>
        Email
        <input required type="email" name="email" placeholder="your.email@example.com" />
      </label>
      <label>
        Subject
        <input required type="text" name="message_subject" placeholder="Project, opportunity, or collaboration" />
      </label>
      <label>
        Message
        <textarea required name="message" rows="6" placeholder="Write your message here"></textarea>
      </label>
      <button class="btn primary" type="submit"><Send size={18} /> Send Message</button>
    </form>
  </div>
</section>

<style>
  .contact-panel {
    position: relative;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 36px;
    align-items: start;
    padding: 42px;
    overflow: hidden;
  }

  .contact-panel::after {
    content: "";
    position: absolute;
    right: -64px;
    top: -64px;
    width: 170px;
    height: 170px;
    border: 22px solid var(--accent);
    opacity: 0.28;
    transform: rotate(25deg);
  }

  .contact-copy {
    position: relative;
    z-index: 2;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }

  .contact-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 800;
  }

  .contact-form {
    display: grid;
    gap: 16px;
    position: relative;
    z-index: 2;
    padding: 0;
  }

  label {
    display: grid;
    gap: 8px;
    color: var(--ink);
    font-weight: 800;
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #0f172a;
    color: var(--ink);
    padding: 12px 13px;
    outline: none;
  }

  input:focus,
  textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(47, 111, 94, 0.14);
  }

  textarea {
    resize: vertical;
  }

  @media (max-width: 860px) {
    .contact-panel {
      grid-template-columns: 1fr;
      padding: 24px;
    }
  }
</style>
