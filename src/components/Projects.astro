---
import ProjectCarousel from './ProjectCarousel';
import { projects } from '../data/projects';
---

<section id="projects" class="section projects">
  <div class="container">
    <div class="projects-head">
      <div>
        <p class="eyebrow">Projects</p>
        <h2 class="section-title">Selected work across web apps, <span class="accent-serif">ML interfaces</span>, and real-time systems.</h2>
      </div>
      <p class="section-lead">
        Each project is presented as a curated card with a meaningful title, short context, stack tags, and a direct
        repository link.
      </p>
    </div>
    <ProjectCarousel projects={projects} client:load />
  </div>
</section>

<style is:global>
  .projects-head {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 28px;
    align-items: end;
  }

  .project-shell {
    position: relative;
    margin-top: 44px;
  }

  .project-controls {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-bottom: 14px;
  }

  .project-controls button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #0f172a;
    color: var(--ink);
    cursor: pointer;
  }

  .project-controls button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .project-card {
    overflow: hidden;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: var(--line-strong);
    box-shadow: 0 36px 90px rgba(0, 0, 0, 0.58), 0 0 30px rgba(34, 211, 238, 0.12);
  }

  .project-visual {
    display: flex;
    align-items: flex-end;
    position: relative;
    min-height: 220px;
    padding: 18px;
    background: linear-gradient(135deg, #173f35, #dce8dd);
    overflow: hidden;
  }

  .project-visual::before {
    content: "";
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 8px;
  }

  .project-visual::after {
    content: "";
    position: absolute;
    right: -36px;
    bottom: -36px;
    width: 120px;
    height: 120px;
    border: 18px solid rgba(34, 211, 238, 0.62);
    transform: rotate(28deg);
  }

  .project-visual.inventory {
    background: linear-gradient(135deg, #173f35, #eef3e8);
  }

  .project-visual.ai {
    background: linear-gradient(135deg, #8a2f2d, #f2d8b5);
  }

  .project-visual.audio {
    background: linear-gradient(135deg, #24364a, #b8d9dd);
  }

  .project-visual.web {
    background: linear-gradient(135deg, #6b4b2d, #ead8ba);
  }

  .project-visual.realtime {
    background: linear-gradient(135deg, #172554, #c3dafe);
  }

  .project-visual.ml {
    background: linear-gradient(135deg, #2f4b3a, #d8e8c8);
  }

  .project-visual span {
    max-width: 12rem;
    position: relative;
    z-index: 2;
    color: white;
    font-size: 1.55rem;
    font-weight: 900;
    line-height: 1.08;
  }

  .project-content {
    display: grid;
    gap: 14px;
    padding: 20px;
  }

  .project-kicker {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-content h3 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .project-content p {
    min-height: 88px;
    margin: 0;
    color: var(--muted);
    line-height: 1.62;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .tags span {
    padding: 6px 8px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 900;
  }

  .project-content a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font-weight: 900;
  }

  @media (max-width: 980px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-grid .project-card:nth-child(3) {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .projects-head,
    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-grid .project-card:nth-child(2) {
      display: none;
    }

    .project-content p {
      min-height: unset;
    }
  }
</style>
